{
  "name": "pi-extensions-workspace",
  "private": true,
  "description": "pnpm workspace hosting multiple pi coding-agent extensions.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "biome format --write",
    "md:format": "prettier --write \"**/*.md\"",
    "lint": "biome lint",
    "check": "biome check",
    "md:check": "prettier --check \"**/*.md\"",
    "fix": "biome check --write",
    "verify": "pnpm -r typecheck && pnpm check && pnpm md:check && pnpm -r test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.1",
    "prettier": "3.9.8",
    "typescript": "^7.0.2"
  }
}
